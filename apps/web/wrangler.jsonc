{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmacko-web",
  // Custom Worker entry: re-exports TanStack Start's fetch handler and adds
  // the non-HTTP handlers (scheduled, later queues) that the generated entry
  // has no room for. See src/server/worker.ts.
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  // Node.js compatibility. With a compatibility_date >= 2026-08-04 workerd
  // enables `nodejs_compat` by default (wrangler NODEJS_COMPAT_DEFAULT_ON_DATE),
  // so nothing is listed here. Turning it off (`no_nodejs_compat`) is not an
  // option today; Phase 0 measured who needs it:
  //   - @tanstack/start-server-core: `node:async_hooks` (AsyncLocalStorage for
  //     the request context) - stays after the migration.
  //   - better-auth: `node:async_hooks` - stays after the migration.
  //   - legacy tRPC/pino/postgres chain (@gmacko/logging, @gmacko/api,
  //     @gmacko/db/client): node:fs, node:os, node:path, node:stream,
  //     node:events, node:buffer, node:url, node:diagnostics_channel - goes
  //     away with Phases 2-6.
  // Verified: with `no_nodejs_compat` the Worker fails at load with
  // `No such module "node:os"`.
  "compatibility_flags": [],
  "observability": { "enabled": true },
  "vars": {
    "STAGE": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gmacko-web",
      // Placeholder until Spike B provisions the real database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}

{
  "name": "@gmacko/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "dev:client": "APP_VARIANT=development expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:device:ios": "eas build --profile development --platform ios",
    "build:device:android": "eas build --profile development --platform android",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "pnpm check:observability preview && eas build --profile preview --platform all",
    "build:prod": "pnpm check:observability production && eas build --profile production --platform all",
    "config:dev": "APP_VARIANT=development expo config --type public",
    "config:preview": "APP_VARIANT=preview expo config --type public",
    "config:prod": "APP_VARIANT=production expo config --type public",
    "check:app-store": "node ./scripts/check-app-store-readiness.mjs",
    "check:observability": "node ./scripts/check-observability.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "e2e": "maestro test .maestro/",
    "e2e:record": "maestro record",
    "e2e:studio": "maestro studio",
    "format": "biome check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "~56.0.18",
    "@gmacko/analytics": "workspace:*",
    "@gmacko/api-client": "workspace:*",
    "@gmacko/config": "workspace:*",
    "@gmacko/domain": "workspace:*",
    "@gmacko/i18n": "workspace:*",
    "@gmacko/monitoring": "workspace:*",
    "@legendapp/list": "^2.0.19",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "buffer": "^6.0.3",
    "effect": "catalog:",
    "expo": "~56.0.18",
    "expo-apple-authentication": "~56.0.4",
    "expo-clipboard": "^56.0.4",
    "expo-constants": "~56.0.22",
    "expo-dev-client": "~56.0.24",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "i18next": "^25.8.18",
    "nativewind": "5.0.0-preview.2",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-i18next": "^16.5.8",
    "react-native": "~0.85.3",
    "react-native-css": "3.0.5",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "~0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@gmacko/tailwind-config": "workspace:*",
    "@gmacko/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "oxlint.config.ts",
    "tools/oxlint/anti-slop/**",
    "biome.json"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:workers": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:fault": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true,
      "env": ["CLOUDFAULT_DEPTH", "CLOUDFAULT_REQUIRED", "CLOUDFAULT_SRC"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "outputs": [
        "playwright-report/**",
        "test-results/**",
        ".maestro/screenshots/**"
      ],
      "cache": false
    },
    "e2e:record": {
      "cache": false,
      "persistent": true
    },
    "e2e:studio": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": [
    "REDIS_URL",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_APPLE_ID",
    "AUTH_APPLE_SECRET",
    "AUTH_APPLE_BUNDLE_ID",
    "AUTH_REDIRECT_PROXY_URL",
    "AUTH_SECRET",
    "BYPASS_MAGIC_LINK",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "PORT",
    "GMACKO_API_URL",
    "GMACKO_API_KEY",
    "LOG_LEVEL",
    "SERVICE_NAME",
    "APP_ENV",
    "API_URL",
    "STAGE",
    "APP_URL",
    "ALLOWED_ORIGINS",
    "VITE_POSTHOG_KEY",
    "VITE_POSTHOG_HOST",
    "VITE_SENTRY_DSN",
    "CLOUDFLARE_ENV",
    "SENTRY_AUTH_TOKEN"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "SKIP_ENV_VALIDATION",
    "PORTLESS_URL",
    "AUTH_GITHUB_URL",
    "AUTH_GITHUB_API_URL",
    "AUTH_GOOGLE_URL",
    "AUTH_GOOGLE_TOKEN_URL",
    "AUTH_APPLE_URL",
    "RESEND_BASE_URL",
    "CLOUDFLARE_*",
    "OTEL_*",
    "SENTRY_*",
    "E2E_*",
    "WRANGLER_*",
    "npm_lifecycle_event"
  ]
}

{
  "name": "@gmacko/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./src/seed.ts"
    },
    "./columns": {
      "types": "./dist/columns.d.ts",
      "default": "./src/columns.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome check .",
    "lint": "oxlint .",
    "generate": "drizzle-kit generate && node scripts/flatten-migrations.mjs",
    "check": "drizzle-kit check",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/web/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../apps/web/wrangler.jsonc",
    "migrate:list": "wrangler d1 migrations list DB --remote --config ../../apps/web/wrangler.jsonc",
    "seed:sql": "tsx scripts/seed-sql.ts",
    "seed:local": "pnpm seed:sql && wrangler d1 execute DB --local --file seed/seed.sql --config ../../apps/web/wrangler.jsonc",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}

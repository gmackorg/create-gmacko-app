{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": [".claude/**", "sdks/generated/**"],
  // `postgres` is imported dynamically by scripts/pg-to-d1.mjs and is
  // deliberately NOT a dependency: that script runs once, against a legacy
  // database, and is invoked with `pnpm dlx --package=postgres`.
  "ignoreDependencies": ["cloudflare", "postgres"],
  "ignoreBinaries": ["expo", "eas", "maestro", "generate"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "turbo/generators/config.ts"]
    },
    "apps/web": {
      "entry": ["src/client.tsx", "scripts/*.mjs", "e2e/**/*.ts"]
    },
    "apps/expo": {
      "entry": ["metro.config.js", "postcss.config.mjs", "src/app/**/*.tsx"],
      "ignore": ["src/components/locale-switcher.tsx"],
      "ignoreDependencies": [
        "buffer",
        "effect",
        "i18next",
        "react-i18next",
        "react-native-worklets",
        "expo-updates",
        "metro-cache"
      ]
    },
    "packages/auth": {
      "entry": ["script/auth-cli.ts"]
    },
    "packages/api-cli": {
      "ignoreDependencies": ["tsx"]
    },
    "packages/mcp-server": {
      "ignoreDependencies": ["tsx"]
    },
    "tooling/tailwind": {
      "ignoreDependencies": ["@tailwindcss/postcss", "postcss", "tailwindcss"]
    },
    "tooling/vitest": {
      "ignoreDependencies": ["@vitest/coverage-v8", "@vitejs/plugin-react"]
    },
    "tooling/openapi-generator": {
      "ignoreDependencies": ["@openapitools/openapi-generator-cli"]
    },
    "packages/notifications": {
      "ignoreDependencies": ["expo"]
    },
    "packages/purchases": {
      "ignoreDependencies": ["react-native"]
    }
  }
}

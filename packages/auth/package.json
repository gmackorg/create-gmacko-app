{
  "name": "@gmacko/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./client": "./src/client.ts",
    "./api-keys": "./src/api-keys.ts",
    "./middleware": "./src/middleware.ts",
    "./request-context": "./src/request-context.ts",
    "./security-config": "./src/security-config.ts",
    "./testing": "./src/testing.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "biome check .",
    "generate": "mkdir -p ../db/.cache && pnpx auth@1.7.2 generate --config script/auth-cli.ts --output ../db/.cache/auth-schema.generated.ts -y && echo \"Wrote packages/db/.cache/auth-schema.generated.ts. Reconcile it into packages/db/src/auth-schema.ts by hand (see that file's header); the committed schema is never overwritten.\"",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@gmacko/db": "workspace:*",
    "@gmacko/domain": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.0"
  }
}

# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# =====================================================
# QUICK LOCAL BOOTSTRAP
# Copy this file to `.env`, then run:
#   pnpm bootstrap:local
#   pnpm dev            # emulate (OAuth/Stripe/Resend emulators) + apps/web on https://gmacko.localhost
#
# The web app (apps/web) runs on Cloudflare Workers with a local D1: it needs
# NO DATABASE_URL. `apps/web/.env` is a link to this file (created by
# `predev`), which is how Wrangler reads these values as Worker bindings.
# Never create `apps/web/.dev.vars`: its presence disables `.env` loading
# (`pnpm check:standards` fails on one).
#
# Required for the default local path:
# - STAGE, AUTH_SECRET
# - the emulate OAuth client ids/secrets below (seeded by emulate.config.yaml)
# Optional for iOS App Store-ready mobile auth:
# - AUTH_APPLE_ID / AUTH_APPLE_SECRET / AUTH_APPLE_BUNDLE_ID
# =====================================================

# =====================================================
# WEB APP (apps/web) — Worker bindings in development
# Read once by apps/web/src/server/config.ts (AppConfig); nothing else reads them.
# In staging/production the same keys are Worker secrets (`pnpm secrets:push --stage <stage>`).
# =====================================================

# development | preview | staging | production (drives cookie security, docs exposure, log level)
STAGE="development"
# Public origin. Under `pnpm dev` (portless) the Worker also receives PORTLESS_URL=https://gmacko.localhost.
APP_URL="http://localhost:3001"

# --- Authentication (better-auth) ---
AUTH_SECRET="set-me-to-a-random-string-of-32-chars-minimum"
# OAuth clients — the values below are the emulator seeds from emulate.config.yaml
AUTH_GITHUB_ID="dev-github-client"
# gmacko-standards-disable-next-line no-committed-credentials -- emulate.config.yaml seed for the local emulator, not a credential
AUTH_GITHUB_SECRET="dev-github-secret"
AUTH_GOOGLE_ID="dev-google-client"
# gmacko-standards-disable-next-line no-committed-credentials -- emulate.config.yaml seed for the local emulator, not a credential
AUTH_GOOGLE_SECRET="dev-google-secret"
# AUTH_APPLE_ID="com.yourcompany.yourapp.service"
# AUTH_APPLE_SECRET=""
# AUTH_APPLE_BUNDLE_ID="com.yourcompany.yourapp"
# Point the providers at emulate (portless names; see `npx @gmacko/emulate` output)
AUTH_GITHUB_URL="https://github.emulate.localhost"
AUTH_GITHUB_API_URL="https://github.emulate.localhost"
AUTH_GOOGLE_URL="https://google.emulate.localhost"
AUTH_GOOGLE_TOKEN_URL="https://google.emulate.localhost/oauth2/token"
# AUTH_APPLE_URL="https://apple.emulate.localhost"
# Print magic links to the server log instead of emailing them. Development only.
BYPASS_MAGIC_LINK="true"

# --- Telemetry (OTLP over HTTP; unset → export off) ---
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp.forgegraf.com"
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer ..."

# --- Monitoring (Sentry) ---
# Worker-side DSN (server errors)
# SENTRY_DSN="https://...@sentry.io/..."
# Browser-side DSN, inlined at build time
# VITE_SENTRY_DSN="https://...@sentry.io/..."
# Source-map upload at build time (CI only)
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="yourapp-web"

# --- Analytics (PostHog, browser) ---
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# --- Payments (Stripe) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) ---
# RESEND_API_KEY=""
# RESEND_BASE_URL="https://resend.emulate.localhost"


# =====================================================
# CLOUDFLARE (deploys, `wrangler` outside `wrangler login`)
# =====================================================

# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_API_TOKEN="your-api-token"

# Redirect every `wrangler d1` / `wrangler r2` call at the local Cloudflare
# emulator instead of Cloudflare, so `wrangler d1 create` and
# `d1 migrations apply --remote` can be rehearsed with no account:
#   npx @gmacko/emulate start --service cloudflare --port 4111
# The value MUST end in `/client/v4` — that is the only prefix
# api.cloudflare.com serves, and the emulator refuses anything else with
# Cloudflare's own 7003 envelope rather than quietly working. Never set this
# in a stage: it would point a real deploy at localhost.
# See docs/drizzle-migrations.md → "Rehearsing a remote migration".
# CLOUDFLARE_API_BASE_URL="http://127.0.0.1:4111/client/v4"


# =====================================================
# MOBILE APP ENV
# Expo dev-client, release builds, and stage-specific values
# =====================================================

# --- Analytics (PostHog) ---
# EXPO_PUBLIC_POSTHOG_KEY="phc_..."
# EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Monitoring (Sentry) ---
# EXPO_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
# SENTRY_PROJECT_MOBILE="yourapp-mobile"

# --- API URLs ---
# STAGING_API_URL="https://staging-api.yourapp.com"
# PRODUCTION_API_URL="https://api.yourapp.com"

# --- Expo release metadata ---
# EXPO_OWNER="your-expo-account"
# EAS_PROJECT_ID="00000000-0000-0000-0000-000000000000"

# --- RevenueCat / Push ---
# See: https://www.revenuecat.com/docs/getting-started
# See: https://docs.expo.dev/push-notifications/overview/


# =====================================================
# OPERATOR LANE (Node: CLI + MCP server)
# =====================================================

# GMACKO_API_URL="http://localhost:3001"
# GMACKO_API_KEY="gmk_..."


# =====================================================
# OPTIONAL RELEASE / CI INFRA
# =====================================================

# --- Package Publishing ---
# NPM_REGISTRY_URL="https://registry.npmjs.org"
# NPM_TOKEN="npm_..."

# --- SDK Publishing ---
# PUBLISH_PYPI="true"
# PYPI_TOKEN="pypi-..."
# PUBLISH_GO="true"

{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.claude",
      "!**/.claude/**",
      "!**/.git",
      "!**/.jj",
      "!**/.turbo",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!docs/plans/**/*.html",
      "!apps/web/src/routeTree.gen.ts",
      "!**/__snapshots__/**",
      "!tools/oxlint/anti-slop/**",
      "!packages/forge-runtime/**",
      "!packages/forge-capability-manifest/**",
      "!apps/forge/src/app.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["tooling/typescript/*.json", "knip.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ]
}

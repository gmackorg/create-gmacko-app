{
  "name": "@gmacko/forge-host",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm migrate:local && wrangler dev --port 8787 --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:local": "wrangler d1 migrations apply gmacko-forge --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "@forgegraph/runtime": "workspace:*",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@gmacko/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
